# NexaShare Sandbox Environment
# This file is for LOCAL TESTING ONLY
# Never commit real secrets!

# ========================================
# DATABASE
# ========================================
# For sandbox, use SQLite (simple file-based database)
DATABASE_URL=file:./sandbox.db

# Or use a test PostgreSQL database (recommended for better testing)
# DATABASE_URL=postgresql://user:pass@localhost:5432/nexashare_sandbox

# ========================================
# LINKEDIN OAUTH
# ========================================
# Use the same client ID as production (it's public)
LINKEDIN_CLIENT_ID=78dsjq2rbcv26t
VITE_LINKEDIN_CLIENT_ID=78dsjq2rbcv26t

# Get this from LinkedIn Developer Console
# IMPORTANT: This is a SECRET - never commit the real value
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# Sandbox redirect (localhost)
VITE_REDIRECT_URI=http://localhost:5000/auth/callback

# ========================================
# SESSION SECURITY
# ========================================
# For sandbox, this can be simple
# For production, generate a secure random string
SESSION_SECRET=sandbox-secret-for-testing-only-change-for-production

# ========================================
# SERVER CONFIGURATION
# ========================================
NODE_ENV=development
PORT=5000
HOST=localhost
DOMAIN=localhost:5000

# ========================================
# STRIPE (Optional - for testing payments)
# ========================================
# Use Stripe TEST keys (start with sk_test_ and pk_test_)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_test_key_here

# ========================================
# FEATURE FLAGS (Sandbox specific)
# ========================================
# Disable auto-repost in sandbox to save API quota
ENABLE_AUTO_REPOST=false

# Enable verbose logging
DEBUG=true
LOG_LEVEL=debug

# ========================================
# API ENDPOINTS
# ========================================
VITE_API_URL=http://localhost:5000/api

# ========================================
# INSTRUCTIONS
# ========================================
# 1. Copy this file to .env.local
# 2. Fill in your actual LinkedIn Client Secret
# 3. (Optional) Add your Stripe test keys
# 4. Save and run: npm run dev
#
# To get LinkedIn Client Secret:
# 1. Go to https://www.linkedin.com/developers/apps
# 2. Select your app
# 3. Go to "Auth" tab
# 4. Copy "Client Secret"
#
# To add localhost redirect URI in LinkedIn:
# 1. In the same "Auth" tab
# 2. Scroll to "Redirect URLs"
# 3. Add: http://localhost:5000/auth/callback
# 4. Save
#
# Note: You can have BOTH production and sandbox redirect URIs!
