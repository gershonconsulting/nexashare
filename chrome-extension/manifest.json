{
  "manifest_version": 3,
  "name": "NexaShare — LinkedIn Content Amplifier",
  "version": "1.0.0",
  "description": "Auto-repost company content to your LinkedIn feed daily. Collect posts and stats.",
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://nexashare.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://nexashare.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "sync-core.js"
  },
  "action": {
    "default_title": "NexaShare",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
